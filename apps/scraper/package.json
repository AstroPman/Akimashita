{
  "name": "scraper",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "main": "src/index.ts",
  "scripts": {
    "dev": "tsx src/index.ts",
    "dev:salons": "tsx src/index.ts --stage=salons",
    "dev:salons:areas": "tsx src/index.ts --stage=salons --phase=areas",
    "dev:salons:discover": "tsx src/index.ts --stage=salons --phase=discover",
    "dev:salons:details": "tsx src/index.ts --stage=salons --phase=details",
    "dev:salons:bookings": "tsx src/index.ts --stage=salons --phase=bookings",
    "dev:salons:therapists": "tsx src/index.ts --stage=salons --phase=therapists",
    "dev:salons:link": "tsx src/index.ts --stage=salons --phase=link",
    "dev:therapists": "tsx src/index.ts --stage=therapists",
    "dev:therapists:new": "tsx src/index.ts --stage=therapists --only-unsynced",
    "dev:therapists:eyoyaku": "tsx src/index.ts --stage=therapists --only-unsynced --site=eyoyaku --max-per-site=20",
    "dev:availability": "tsx src/index.ts --stage=availability",
    "dev:availability:eyoyaku": "tsx src/index.ts --stage=availability --site=eyoyaku",
    "dev:availability:main": "tsx src/index.ts --stage=availability --exclude-site=eyoyaku",
    "dev:official-shifts": "tsx src/index.ts --stage=official_shifts",
    "dev:notify": "tsx src/index.ts --stage=notify",
    "dev:notify:dry": "tsx src/index.ts --stage=notify --dry-run",
    "inspect:grow": "tsx src/scrapers/grow/_inspect.ts",
    "build:salons-seed": "tsx src/scripts/build_salons_seed.ts",
    "audit:official-shifts": "tsx src/scripts/audit_official_shifts.ts",
    "audit:official-shifts:estama": "tsx src/scripts/audit_official_shifts.ts --internal-site=estama --per-host=1 --out=output/official_shifts_coverage_estama.csv",
    "build": "rm -rf dist && node ./build.mjs",
    "typecheck": "tsc --noEmit",
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "license": "ISC",
  "devDependencies": {
    "@types/aws-lambda": "^8.10.161",
    "@types/node": "^25.6.0",
    "@types/tough-cookie": "^4.0.5",
    "esbuild": "^0.28.0",
    "playwright": "^1.49.1",
    "ts-node": "^10.9.2",
    "tsx": "^4.19.2",
    "typescript": "^6.0.3"
  },
  "dependencies": {
    "@alimashita/shared": "*",
    "@supabase/supabase-js": "^2.46.1",
    "cheerio": "^1.0.0",
    "dotenv": "^16.4.7",
    "resend": "^6.12.2",
    "tough-cookie": "^5.0.0"
  }
}
